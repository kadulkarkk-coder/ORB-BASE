# Local Llama is the default. If runtime or model files are missing,
# WEBSTER uses the built-in offline engine; it never falls back to a cloud API.
JARVIS_AI_PROVIDER=llama
WEBSTER_LLAMA_MODEL=models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
WEBSTER_LLAMA_CONTEXT=4096
WEBSTER_LLAMA_THREADS=3

# Optional local Home Assistant integration. Keep real values private.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ALLOWED_ENTITIES=
